# Optional. Increases GitHub's search API rate limit. Server-side only —
# never prefix with NEXT_PUBLIC_. The app works without it (unauthenticated,
# lower rate limit).
GITHUB_TOKEN=

# Optional. Standard PostgreSQL connection string, e.g.
# postgres://user:password@localhost:5432/ai_news_hub
# Provider-agnostic on purpose — works with any Postgres host (local,
# Docker, Neon, Railway, Supabase, etc.), only ever read server-side.
# The app builds and runs fine without it (falls back to live-fetch-only
# mode, no persistence).
DATABASE_URL=

# Optional. Enables AI enrichment (src/lib/ai/) — concise summaries, topic
# tags, and a relevance estimate for persisted articles. Server-side only,
# never sent to the client. Without any provider configured below,
# `getAiProvider()` returns null and enrichment is skipped everywhere
# (page rendering, the batch CLI) — the app is fully functional with no
# AI provider configured at all.

# Optional. Explicit provider selector: "anthropic" (default if unset) or
# "openai". Each provider requires its OWN complete configuration below —
# there is no fallback between providers if one is only half-configured.
AI_PROVIDER=

# Used when AI_PROVIDER is unset or "anthropic".
ANTHROPIC_API_KEY=

# Optional. Defaults to a small, cheap Claude model suited to short
# structured-output tasks (see src/lib/ai/anthropicProvider.ts) if unset.
ANTHROPIC_ENRICHMENT_MODEL=

# Used when AI_PROVIDER=openai. Server-side only, never sent to the client.
OPENAI_API_KEY=

# Required when AI_PROVIDER=openai — unlike Anthropic, there is no default
# OpenAI model baked into the app. Choose one your account/project can
# access (query the OpenAI Models API to see what's available) and set it
# explicitly here; see src/lib/ai/openaiProvider.ts.
OPENAI_ENRICHMENT_MODEL=

# Optional (Step 17). Enables semantic embedding generation and vector
# search (src/lib/ai/embeddingService.ts, semanticSearch.ts) — deliberately
# has NO default and is NEVER inferred from OPENAI_ENRICHMENT_MODEL above:
# an embedding model is a distinct, explicit choice with its own dimension
# and pricing characteristics. Without this set, `getEmbeddingProvider()`
# returns null and every embedding code path (the ai:embed CLI, semantic
# search) is a safe no-op — the app is fully functional with no embedding
# model configured at all, exactly like AI enrichment above. Uses the same
# OPENAI_API_KEY. See the Step 17 final report for the embedding-capable
# models available to query via the OpenAI Models API before choosing one.
OPENAI_EMBEDDING_MODEL=
